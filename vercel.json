{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "privacy.html",
      "use": "@vercel/static"
    },
    {
      "src": "app-ads.txt",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/privacy(\\.html)?/?",
      "dest": "/privacy.html"
    },
    {
      "src": "/privacidade/?",
      "dest": "/privacy.html"
    },
    {
      "src": "/app-ads\\.txt",
      "dest": "/app-ads.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
